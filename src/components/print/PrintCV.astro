---
import { Image } from "astro:assets"
import portrait from "../../assets/profile.png"
import {
  community,
  education,
  languages,
  links,
  previous,
  profile,
  projects,
  reaktor,
  technologies,
} from "../../data/cv"
import { formatRange, formatYears } from "../../lib/format"
import LinkText from "../LinkText.astro"
---

<article class="pcv">
  <header class="pcv__head">
    <div>
      <h1 class="pcv__name">{profile.name}</h1>
      <p class="pcv__title">{profile.headline}</p>
      <ul class="pcv__contact">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>
                <LinkText text={link.display} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <Image class="pcv__photo" src={portrait} alt={`Portrait of ${profile.name}`} width={300} />
  </header>

  <section class="pcv__row">
    <h2 class="pcv__label">Profile</h2>
    <div class="pcv__body">
      {profile.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="pcv__row pcv__row--flow">
    <h2 class="pcv__label">Experience</h2>
    <div class="pcv__body pcv__jobs">
      <div class="pcv__job">
        <h3 class="pcv__job-title">{reaktor.company}</h3>
        <p class="pcv__meta">
          <span>{reaktor.role}, {reaktor.location}</span>
          <span>{formatRange(reaktor.start, reaktor.end)}</span>
        </p>
        {reaktor.description.map((paragraph) => <p>{paragraph}</p>)}
        <p class="pcv__sublabel">Selected projects</p>
        <div class="pcv__projects">
          {
            projects.map((project) => (
              <div class="pcv__item">
                <h4 class="pcv__item-title">
                  {project.title} <span class="pcv__when">{project.focus}</span>
                </h4>
                <p>{project.text}</p>
              </div>
            ))
          }
        </div>
        <dl class="pcv__tech">
          {
            technologies.map((group) => (
              <div>
                <dt>{group.name}</dt>
                <dd>{group.items.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {
        previous.map((job) => (
          <div class="pcv__job">
            <h3 class="pcv__job-title pcv__job-title--small">{job.company}</h3>
            <p class="pcv__meta">
              <span>
                {job.role}, {job.location}
              </span>
              <span>{formatRange(job.start, job.end)}</span>
            </p>
            <p>
              {job.about} {job.description.join(" ")}
            </p>
            {job.keywords && <p class="pcv__keywords">{job.keywords.join(", ")}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <section class="pcv__row">
    <h2 class="pcv__label">Beyond client work</h2>
    <div class="pcv__body pcv__grid">
      {
        community.map((item) => (
          <div class="pcv__item">
            <h3 class="pcv__item-title">
              {item.title} <span class="pcv__when">{item.when}</span>
            </h3>
            <p>{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="pcv__row">
    <h2 class="pcv__label">Education</h2>
    <div class="pcv__body">
      <p>
        {
          `${education.degrees.map((d) => `${d.degree} (${formatYears(d.start, d.end)})`).join(" and ")}, ${education.school}. ${education.note}`
        }
      </p>
    </div>
  </section>

  <section class="pcv__row">
    <h2 class="pcv__label">Languages</h2>
    <p class="pcv__body">
      {languages.map((item) => `${item.language} (${item.level.charAt(0).toLowerCase()}${item.level.slice(1)})`).join(", ")}
    </p>
  </section>
</article>

<style>
  @page {
    size: A4;
    margin: 14mm 16mm 15mm;
  }

  .pcv {
    --label: 30mm;
    --gap: 6mm;
    font-family: var(--serif);
    font-size: 9.2pt;
    line-height: 1.38;
    color: var(--ink);
    background: var(--white);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  @media screen {
    .pcv {
      width: 210mm;
      min-height: 297mm;
      margin: 2rem auto;
      padding: 14mm 16mm 15mm;
      box-shadow:
        0 1px 3px rgb(22 28 45 / 0.08),
        0 12px 40px rgb(22 28 45 / 0.1);
    }
  }

  .pcv p,
  .pcv ul,
  .pcv dl,
  .pcv dd {
    margin: 0;
  }

  .pcv a {
    color: inherit;
    text-decoration: none;
  }

  .pcv__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8mm;
    padding-bottom: 6mm;
  }

  /* Headroom keeps the accent on "Á" inside the printable area at the top of the page. */
  .pcv__name {
    padding-top: 1.5mm;
    font-size: 25pt;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .pcv__title {
    margin-top: 2mm !important;
    font-family: var(--sans);
    font-size: 9.5pt;
    color: var(--slate);
  }

  .pcv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1mm 5mm;
    margin-top: 2.5mm !important;
    padding: 0;
    list-style: none;
    font-family: var(--sans);
    font-size: 8pt;
    font-weight: 500;
    color: var(--accent);
  }

  .pcv__photo {
    flex: none;
    width: 21mm;
    height: 21mm;
    border-radius: 50%;
    object-fit: cover;
  }

  .pcv__row {
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    column-gap: var(--gap);
    padding-block: 3.2mm;
    border-top: 0.6pt solid var(--hairline);
    break-inside: avoid;
  }

  .pcv__row--flow {
    break-inside: auto;
  }

  .pcv__job,
  .pcv__item {
    break-inside: avoid;
  }

  .pcv__label {
    padding-top: 0.4mm;
    font-family: var(--sans);
    font-size: 8.3pt;
    font-weight: 600;
    line-height: 1.3;
  }

  .pcv__body {
    display: grid;
    align-content: start;
    gap: 1.6mm;
  }

  .pcv__jobs {
    gap: 4mm;
  }

  .pcv__job {
    display: grid;
    gap: 1.3mm;
  }

  .pcv__job-title {
    font-size: 11.5pt;
    font-weight: 500;
    line-height: 1.2;
  }

  .pcv__job-title--small {
    font-size: 10pt;
  }

  .pcv__meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 4mm;
    margin-top: -0.6mm !important;
    font-family: var(--sans);
    font-size: 7.8pt;
    color: var(--slate);
  }

  .pcv__tech {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2mm 5mm;
    margin-top: 1.2mm !important;
    padding-top: 2.2mm;
    border-top: 0.6pt solid var(--hairline);
  }

  .pcv__tech dt,
  .pcv__keywords,
  .pcv__when {
    font-family: var(--sans);
    font-size: 7.4pt;
    font-weight: 500;
    color: var(--slate);
    white-space: nowrap;
  }

  .pcv__tech dd {
    line-height: 1.3;
  }

  .pcv__sublabel {
    margin-top: 1.2mm !important;
    font-family: var(--sans);
    font-size: 7.8pt;
    font-weight: 600;
  }

  .pcv__projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4mm 6mm;
  }

  .pcv__grid {
    grid-template-columns: 1fr 1fr;
    gap: 2.5mm 6mm;
  }

  .pcv__item {
    display: grid;
    gap: 0.6mm;
    align-content: start;
  }

  /* Title and its tag share a line when they fit, without an indent when they don't. */
  .pcv__item-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1.6mm;
    font-size: 9.4pt;
    font-weight: 500;
    line-height: 1.3;
  }
</style>
