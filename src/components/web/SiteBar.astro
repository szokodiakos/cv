---
import { profile } from "../../data/cv"
import { withBase } from "../../lib/format"
---

<header class="bar" data-bar>
  <div class="bar__inner wrap">
    <a class="bar__name" href="#name">{profile.name}</a>
    <nav class="bar__nav" aria-label="Sections">
      <a href="#experience">Experience</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="bar__pdf" href={withBase("akos-szokodi-cv.pdf")} download>Download PDF</a>
  </div>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 93%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--hairline);
    opacity: 0;
    transform: translateY(-100%);
    transition:
      transform 0.45s var(--ease-out),
      opacity 0.45s;
  }

  .bar:focus-within,
  .bar.is-visible {
    opacity: 1;
    transform: none;
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 3.25rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .bar__name {
    margin-right: auto;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 500;
    text-decoration: none;
  }

  .bar__nav {
    display: flex;
    gap: 1.5rem;
  }

  .bar__nav a,
  .bar__pdf {
    color: var(--slate);
    text-decoration: none;
  }

  .bar__nav a:hover,
  .bar__pdf:hover {
    color: var(--ink);
  }

  .bar__pdf {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .bar__nav {
      display: none;
    }
  }
</style>
